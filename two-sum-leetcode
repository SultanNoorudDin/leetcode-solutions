class Solution {
public:
    vector<int> twoSum(vector<int>& arr, int target) {
        int length = arr.size();
        int z1=-1,z2=-1;
        for (int i=0; i <length; i++){
            for(int j=i+1; j<length;j++){
                if(arr[i]+arr[j]==target){
                    return {i,j};
                }
            }
            
        }
        return {};
    }
};
